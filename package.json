{
  "name": "kempo-credits",
  "version": "0.0.2",
  "description": "An in-app currency for kempo — a credits ledger with paid and promotional balances, packs and promo links (planned; see PLAN.md)",
  "license": "MIT",
  "author": "Dustin Poissant",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.js kempo-test -l minimal",
    "link:local": "npm install ../kempo ../kempo-server ../kempo-ui ../kempo-payments --no-save --no-legacy-peer-deps --force"
  },
  "files": [
    "admin",
    "public",
    "server",
    "install.js",
    "update.js",
    "sdk.js",
    "kempo-config.json",
    "PLAN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-credits.git"
  },
  "peerDependencies": {
    "kempo": ">=4.5.8",
    "kempo-server": ">=3.3.0",
    "kempo-ui": ">=0.4.53",
    "kempo-payments": ">=0.1.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-orm": "^0.45.2",
    "kempo-testing-framework": "^1.4.11",
    "postgres": "^3.4.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.7.0": true
  }
}
