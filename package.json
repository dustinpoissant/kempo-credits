{
  "name": "kempo-credits",
  "version": "0.3.0",
  "description": "An in-app currency ledger for kempo — balances, an append-only history, transfers between users, and an SDK other extensions use to create and spend credits",
  "license": "MIT",
  "author": "Dustin Poissant <dustinpoissant@gmail.com>",
  "type": "module",
  "main": "sdk.js",
  "scripts": {
    "test": "node scripts/run-tests.js unit kempo-test -l minimal",
    "test:integration": "node scripts/run-tests.js integration kempo-test -l minimal -t 120000",
    "link:local": "npm install ../kempo ../kempo-server ../kempo-ui --no-save --no-legacy-peer-deps --force"
  },
  "exports": {
    "./install": "./install.js",
    "./update": "./update.js",
    "./uninstall": "./uninstall.js",
    "./sdk": "./sdk.js"
  },
  "files": [
    "admin",
    "public",
    "server",
    "install.js",
    "update.js",
    "uninstall.js",
    "sdk.js",
    "kempo-config.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-credits.git"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "kempo": ">=4.9.6",
    "kempo-server": ">=3.3.0",
    "kempo-ui": ">=0.6.2"
  },
  "peerDependenciesMeta": {
    "kempo-products": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-kit": "^0.31.10",
    "kempo-testing-framework": "^1.4.11",
    "playwright": "^1.64.0",
    "postgres": "^3.4.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.7.0": true
  }
}
